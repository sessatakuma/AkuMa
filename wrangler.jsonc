{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "akuma",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "akuma",
        },
    ],
    "observability": {
        "enabled": true,
    },
    // Declarative routing — Worker is the sole origin for both hosts, so
    // `custom_domain: true` lets Cloudflare auto-provision DNS + SSL.
    // See README "Cloudflare routing" for the redirect/cleanup plan.
    "routes": [
        { "pattern": "akuma.sessatakuma.dev", "custom_domain": true },
        { "pattern": "accent-marker.sessatakuma.dev", "custom_domain": true },
    ],
    // Secrets (set via `wrangler secret put` or the dashboard, NOT here):
    //   MARK_ACCENT_API_KEY        (required)
    //   MARK_ACCENT_UPSTREAM_URL   (optional; defaults to api.sessatakuma.dev)
    // Local dev: see README — secrets/vars are read from .env on `bun dev`
    // and from the Worker's runtime vars on `bun run preview`.
}
