{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "akuma",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "akuma",
        },
    ],
    "observability": {
        "enabled": true,
    },
    // Secrets (set via `wrangler secret put` or the dashboard, NOT here):
    //   MARK_ACCENT_API_KEY        (required)
    //   MARK_ACCENT_UPSTREAM_URL   (optional; defaults to api.sessatakuma.dev)
    // For local dev these live in `.dev.vars` (see `.dev.vars.example`).
}
