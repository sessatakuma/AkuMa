{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "akuma",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "akuma",
        },
    ],
    "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": false },
    },
    // ── Cutover (intentionally commented out in this PR) ──────────────────
    // Uncomment the `routes` block in the cutover PR (#117). Until then the
    // production hosts keep serving from Vercel and only `akuma-cf.*` points
    // at this Worker. Because `custom_domain: true` lets Cloudflare
    // auto-provision DNS at the zone, deploying with this block enabled is a
    // one-way door — it flips `akuma.sessatakuma.dev` from Vercel to this
    // Worker on the next `main` deploy. Keep it commented until sign-off.
    //
    // "routes": [
    //     { "pattern": "akuma.sessatakuma.dev", "custom_domain": true },
    //     { "pattern": "accent-marker.sessatakuma.dev", "custom_domain": true },
    // ],
    // Secrets (set via `wrangler secret put` or the dashboard, NOT here):
    //   MARK_ACCENT_API_KEY        (required)
    //   MARK_ACCENT_UPSTREAM_URL   (optional; defaults to api.sessatakuma.dev)
    // Local dev: see README — secrets/vars are read from .env on `bun dev`
    // and from the Worker's runtime vars on `bun run preview`.
}
