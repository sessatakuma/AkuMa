{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "akuma",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "akuma",
        },
    ],
    "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": false },
    },
    // Production custom domains. `custom_domain: true` lets Cloudflare
    // auto-provision DNS + managed TLS at the `sessatakuma.dev` zone.
    // Workers Builds (CI) must have a token with the scopes documented in
    // README → "Workers Builds token permissions"; otherwise the deploy
    // fails on `PUT .../workers/scripts/akuma/domains/records`. See #117.
    "routes": [
        { "pattern": "akuma.sessatakuma.dev", "custom_domain": true },
        { "pattern": "accent-marker.sessatakuma.dev", "custom_domain": true },
    ],
    // Secrets (set via `wrangler secret put` or the dashboard, NOT here):
    //   MARK_ACCENT_API_KEY        (required)
    //   MARK_ACCENT_UPSTREAM_URL   (optional; defaults to api.sessatakuma.dev)
    // Local dev: see README — secrets/vars are read from .env on `bun dev`
    // and from the Worker's runtime vars on `bun run preview`.
}
